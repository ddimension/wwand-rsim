{
	"luci-app-wwand-rsim": {
		"description": "Grant access to the wwand remote SIM page",
		"read": {
			"ubus": {
				"wwand": [
					"status",
					"modem_plugin_status"
				]
			},
			"file": {
				"/etc/wwand/rsim/id_dropbear.pub": [
					"read"
				],
				"/etc/wwand/rsim/id_ed25519.pub": [
					"read"
				]
			},
			"uci": [
				"network"
			]
		},
		"write": {
			"ubus": {
				"wwand": [
					"modem_plugin"
				]
			},
			"uci": [
				"network"
			],
			"file": {
				"/usr/bin/wwandctl rsim scan --json": [
					"exec"
				],
				"/usr/bin/wwandctl rsim scan * --json": [
					"exec"
				],
				"/usr/bin/wwandctl rsim ssh-key": [
					"exec"
				],
				"/usr/bin/wwandctl rsim test * --json": [
					"exec"
				]
			}
		}
	}
}
